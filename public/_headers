# Cloudflare Pages cache control
# Never cache the HTML shell or service worker — always fetch fresh
# so deployed fixes take effect immediately for all users.
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/firebase-messaging-sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Hashed assets are safe to cache forever — filename changes on every build
/assets/*
  Cache-Control: public, max-age=31536000, immutable
