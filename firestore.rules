rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users + ALL subcollections ────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // commandCenter, tasks, agentLogs, callLogs etc — all under user
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        // Nested subcollections (e.g. commandCenter/data)
        match /{nested}/{nestedId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // ── Direct Chats ──────────────────────────────────────
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Groups ────────────────────────────────────────────
    match /groups/{groupId} {
      allow read, write: if request.auth != null;
      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Calls + ICE candidate subcollections ──────────────
    match /calls/{callId} {
      allow read, write: if request.auth != null;
      match /callerCandidates/{docId} {
        allow read, write: if request.auth != null;
      }
      match /calleeCandidates/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Meeting Rooms ─────────────────────────────────────
    match /meetings/{meetingId} {
      allow read, write: if request.auth != null;
      match /waiting/{docId} {
        allow read, write: if request.auth != null;
      }
      match /admitted/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Group Calls ───────────────────────────────────────
    match /groupCalls/{callId} {
      allow read, write: if request.auth != null;
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Status / Moments ──────────────────────────────────
    match /status/{statusId} {
      allow read, write: if request.auth != null;
    }
  }
}
