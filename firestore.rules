rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users + ALL subcollections ────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // commandCenter, tasks, agentLogs, callLogs etc — all under user
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        // Nested subcollections (e.g. commandCenter/data)
        match /{nested}/{nestedId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // ── Direct Chats ──────────────────────────────────────
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Groups ────────────────────────────────────────────
    match /groups/{groupId} {
      allow read, write: if request.auth != null;
      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Calls + ICE candidate subcollections ──────────────
    match /calls/{callId} {
      allow read, write: if request.auth != null;
      match /callerCandidates/{docId} {
        allow read, write: if request.auth != null;
      }
      match /calleeCandidates/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Meeting Rooms ─────────────────────────────────────
    match /meetings/{meetingId} {
      allow read, write: if request.auth != null;
      match /waiting/{docId} {
        allow read, write: if request.auth != null;
      }
      match /admitted/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Group Calls ───────────────────────────────────────
    match /groupCalls/{callId} {
      allow read, write: if request.auth != null;
      // signals/{offererUid_answererUid} — 1 level deep, covered here
      match /signals/{docId} {
        allow read, write: if request.auth != null;
      }
      // candidates/{key}/list/{autoId} — 2 levels deep. The previous rule
      // only matched 1 level (groupCalls/{callId}/{subcollection}/{docId}),
      // so every ICE candidate write/read here was silently denied —
      // this is exactly why meeting/group calls connected the signaling
      // (offer/answer) but never actually established media (no ICE).
      match /candidates/{key} {
        allow read, write: if request.auth != null;
        match /list/{docId} {
          allow read, write: if request.auth != null;
        }
      }
    }

    // ── Status / Moments ──────────────────────────────────
    // App code writes to 'statuses' (plural) — this MUST match exactly,
    // otherwise Firestore silently denies all reads/writes to it with
    // permission-denied, which is exactly what was causing every single
    // moment post (text AND image) to fail.
    match /statuses/{statusId} {
      allow read, write: if request.auth != null;
    }
  }
}
