# ── Firebase (required) ──────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_VAPID_KEY=

# ── AI Providers (optional — feature degrades gracefully) ────────
VITE_GROQ_API_KEY=
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=

# ── FCM Push (optional) ──────────────────────────────────────────
VITE_SA_CLIENT_EMAIL=
VITE_SA_PRIVATE_KEY=

# ── LiveKit AI Voice (optional) ─────────────────────────────────
# Get these from https://cloud.livekit.io (Free tier available)
# Leave blank to run in browser STT/TTS fallback mode.
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
VITE_LIVEKIT_TOKEN_ENDPOINT=/api/livekit-token

# Set these in Cloudflare Pages dashboard (server-side only, never expose to client):
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
