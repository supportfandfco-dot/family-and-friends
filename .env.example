# ── Firebase (required) ──────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_VAPID_KEY=

# ── Media Uploads (required — replaces Firebase Storage, no card needed) ──
# ImgBB (images — avatars, moments, chat/group photos): https://api.imgbb.com/
VITE_IMGBB_API_KEY=
# Cloudinary (audio/video — voice notes): https://cloudinary.com/users/register/free
# Create an UNSIGNED upload preset under Settings → Upload → Upload presets
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ── AI Providers (optional — feature degrades gracefully) ────────
VITE_GROQ_API_KEY=
VITE_GEMINI_API_KEY=
# NOTE: The server-side functions (server.ts locally, functions/api/gemini.js
# on Cloudflare Pages) read GEMINI_API_KEY WITHOUT the VITE_ prefix — set both:
GEMINI_API_KEY=
GROQ_API_KEY=
VITE_OPENAI_API_KEY=

# ── FCM Push (optional) ──────────────────────────────────────────
# CRITICAL: These must be set WITHOUT the VITE_ prefix and ONLY in the
# Cloudflare Pages dashboard (Settings → Environment Variables), never
# in a client-side .env file. VITE_-prefixed vars are bundled into the
# public JS and would leak this service account's private key to every
# visitor. The send-push function (functions/api/send-push.js) reads:
# SA_CLIENT_EMAIL=
# SA_PRIVATE_KEY=
# FIREBASE_PROJECT_ID=family-friends-ee992
# (VITE_FIREBASE_VAPID_KEY above is the separate client-side key for token registration)

# ── LiveKit AI Voice (optional) ─────────────────────────────────
# Get these from https://cloud.livekit.io (Free tier available)
# Leave blank to run in browser STT/TTS fallback mode.
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
VITE_LIVEKIT_TOKEN_ENDPOINT=/api/livekit-token

# Set these in Cloudflare Pages dashboard (server-side only, never expose to client):
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
